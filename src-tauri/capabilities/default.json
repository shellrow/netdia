{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/shellrow"
        },
        {
          "url": "https://github.com/shellrow/netdia"
        },
        {
          "url": "https://donate.stripe.com/3cIbJ046Q0671z6ctHgIo01"
        },
        {
          "url": "https://apps.microsoft.com/detail/9NLQ03PT1DXQ"
        },
        {
          "url": "ms-windows-store://pdp/?productid=9NLQ03PT1DXQ"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/.netdia"
        },
        {
          "path": "$HOME/.netdia/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        {
          "path": "$HOME/.netdia/**"
        }
      ]
    },
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
